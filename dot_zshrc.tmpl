{{- if eq .chezmoi.os "darwin" -}}
# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}

export PATH=$HOME/.local/bin:$PATH

# Fall back to xterm-256color if the terminal type is not known to this system
if [[ -n "$TERM" ]] && ! infocmp "$TERM" &>/dev/null 2>&1; then
    export TERM=xterm-256color
fi

# Source credential/env files if they exist
for f in ~/.awscredentials ~/.jenkinstoken ~/.atlassian ~/.snowflaketoken ~/.ghtoken; do
    [ -f "$f" ] && source "$f"
done

# fzf completion must be loaded before compinit
{{- if eq .chezmoi.os "darwin" }}
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
{{- else }}
[ -f ~/.config/fzf/completion.zsh ] && source ~/.config/fzf/completion.zsh
{{- end }}

# Add custom completions to fpath before compinit
fpath=(~/.zsh/completions $fpath)

# Initialize completion system
autoload -Uz compinit
compinit

# Configure completion system
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*:match:*' original only
zstyle ':completion:*:approximate:*' max-errors 1 numeric

# Enable completion caching
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path ~/.zsh/cache

# Add cargo to PATH for Sheldon
export PATH="$HOME/.cargo/bin:$PATH"

# Bottom-up prompt setup
# Add some space to push prompt towards bottom
export PROMPT_EOL_MARK=""

# Function to add padding and keep prompt at bottom
bottom_up_padding() {
    local terminal_height=$(tput lines)
    local content_height=10  # Adjust based on your preference
    local padding=$((terminal_height - content_height))

    if [ $padding -gt 0 ]; then
        printf '\n%.0s' $(seq 1 $padding)
    fi
}

# Alternative: Manual bottom-up command
alias bottom='clear; printf "\n%.0s" $(seq 1 $(($(tput lines) - 5)))'

# Function to start a bottom-up session
start_bottom_up() {
    clear
    printf '\n%.0s' $(seq 1 $(($(tput lines) - 10)))
    echo "🚀 Bottom-up mode activated! Type 'bottom' to reset position."
}

# Split-screen prompt sessions
alias split='split-prompt'
alias sp='split-prompt'
alias asplit='advanced-split'
alias as='advanced-split'

# Editor shortcuts
alias n='nvim'
alias v='nvim'
alias vim='nvim'

# Tmux shortcuts
alias t='tmux'
alias ta='tmux attach-session'
alias tat='tmux attach-session -t'
alias tls='tmux list-sessions'
alias tn='tmux new-session'
alias tns='tmux new-session -s'
alias tk='tmux kill-session'
alias tks='tmux kill-session -t'
alias td='tmux detach'
alias ts='tmux switch-client -t'
alias tw='tmux list-windows'
alias tp='tmux list-panes'

# Sync AI knowledge repos (ai-history + claude-kb)
sync-ai() {
    local failed=0
    for repo in ~/ai-history ~/claude-kb; do
        [[ -d "$repo/.git" ]] || continue
        local name=$(basename "$repo")
        echo "--- $name ---"
        git -C "$repo" add -A
        if git -C "$repo" diff --cached --quiet; then
            echo "nothing to commit"
            continue
        fi
        local msg
        msg=$(git -C "$repo" diff --cached --stat | claude -p \
            "Write a short git commit message (1 line, no quotes) summarizing these changes to my $name repo. Just the message, nothing else." 2>/dev/null) \
            || msg="sync $(date +%Y-%m-%d/%H:%M)"
        echo "commit: $msg"
        git -C "$repo" commit -m "$msg" && \
        git -C "$repo" push || { echo "FAILED: $repo"; failed=1; }
    done
    return $failed
}

# Modern CLI Tools
alias ls='eza --color=always --group-directories-first --icons'
compdef _eza ls ll la lt 2>/dev/null
compdef _rg grep 2>/dev/null
alias ll='eza -l --color=always --group-directories-first --icons'
alias la='eza -la --color=always --group-directories-first --icons'
alias lt='eza -T --color=always --group-directories-first --icons'
alias l.='eza -a | command grep -E "^\."'
command -v fd &>/dev/null && alias find='fd'
command -v fdfind &>/dev/null && alias find='fdfind'
alias grep='rg'
# zoxide: handled by zoxide init below

# C++ Compiler Default Flags
export CXXFLAGS="-std=c++23 -Wall -Wextra -O2 -g"
export CFLAGS="-Wall -Wextra -O2 -g"
export LDFLAGS=""  # Add linker flags here if needed

{{- /* Cross-platform GCC configuration */ -}}
{{- if eq .chezmoi.os "darwin" }}
# macOS: Use Homebrew GCC 15
alias gpp='g++-15 -std=c++23 -Wall -Wextra -O2 -g'
alias c++23='g++-15 -std=c++23 -Wall -Wextra -O2 -g'
export CXX='g++-15'
export CC='gcc-15'
alias g++debug='g++-15 -std=c++23 -Wall -Wextra -g -O0 -DDEBUG'
alias g++release='g++-15 -std=c++23 -Wall -Wextra -O3 -DNDEBUG'
alias g++fast='g++-15 -std=c++23 -O3 -march=native'
alias gccbuild='gcc-15 -std=c2x -Wall -Wextra -O2 -g'
alias gccdebug='gcc-15 -std=c2x -Wall -Wextra -g -O0 -DDEBUG'
alias gccfast='gcc-15 -std=c2x -O3 -march=native'
alias gcc15='gcc-15'
alias gpp15='g++-15'
{{- else }}
# Linux: Use system GCC (or installed GCC)
alias gpp='g++ -std=c++23 -Wall -Wextra -O2 -g'
alias c++23='g++ -std=c++23 -Wall -Wextra -O2 -g'
export CXX='g++'
export CC='gcc'
alias g++debug='g++ -std=c++23 -Wall -Wextra -g -O0 -DDEBUG'
alias g++release='g++ -std=c++23 -Wall -Wextra -O3 -DNDEBUG'
alias g++fast='g++ -std=c++23 -O3 -march=native'
alias gccbuild='gcc -std=c2x -Wall -Wextra -O2 -g'
alias gccdebug='gcc -std=c2x -Wall -Wextra -g -O0 -DDEBUG'
alias gccfast='gcc -std=c2x -O3 -march=native'
alias gcc15='gcc'
alias gpp15='g++'
{{- end }}

# Custom completion will be set up after fzf loads

# Function to run command and display output in top pane
run_split() {
    if [[ -n $TMUX ]]; then
        # Run command and send output to top pane
        eval "$@" | tmux send-keys -t 0 "$(cat)" Enter
    else
        echo "❌ Not in tmux session. Run 'split' first."
    fi
}

# Basic completion setup (bypassing zplug for now)

{{/* Cross-platform zsh plugins */}}
# fzf-tab: replace zsh completion menu with fzf (must be after compinit, before other plugins)
[ -f ~/.config/fzf-tab/fzf-tab.plugin.zsh ] && source ~/.config/fzf-tab/fzf-tab.plugin.zsh

# Basic autosuggestions and syntax highlighting (if available)
{{- if eq .chezmoi.os "darwin" }}
if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
{{- else }}
if [[ -f ~/.nix-profile/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source ~/.nix-profile/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [[ -f /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ -f ~/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source ~/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -f /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
{{- end }}

# Ensure TAB completion works properly
bindkey '^I' expand-or-complete
bindkey '^[[Z' reverse-menu-complete
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char
bindkey '^L' clear-screen

# Zoxide - Smart directory jumping (replaces cd command)
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh --cmd cd)"
fi

{{- /* Git-extras completions - cross-platform */ -}}
{{- if eq .chezmoi.os "darwin" }}
# macOS: Homebrew git-extras
if [[ -f /opt/homebrew/opt/git-extras/share/git-extras/git-extras-completion.zsh ]]; then
  source /opt/homebrew/opt/git-extras/share/git-extras/git-extras-completion.zsh
fi
{{- else }}
# Linux: Try common locations for git-extras
if [[ -f /usr/share/git-extras/git-extras-completion.zsh ]]; then
  source /usr/share/git-extras/git-extras-completion.zsh
elif [[ -f /usr/local/share/git-extras/git-extras-completion.zsh ]]; then
  source /usr/local/share/git-extras/git-extras-completion.zsh
fi
{{- end }}

# fzf key bindings (completion already sourced above before compinit)
{{- if ne .chezmoi.os "darwin" }}
[ -f ~/.config/fzf/key-bindings.zsh ] && source ~/.config/fzf/key-bindings.zsh
{{- end }}

# Starship Prompt
if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# Note: Tab completion shows some extra entries like 'file' command
# This is normal behavior with enhanced completion systems (fzf, zoxide, etc.)

export DISABLE_AUTOUPDATER=1

# Zellij
alias zj="zellij"
if command -v zellij &>/dev/null; then
    mkdir -p ~/.zsh/completions
    zellij setup --generate-completion zsh > ~/.zsh/completions/_zellij
    fpath=(~/.zsh/completions $fpath)
fi

# Inside zellij: make 'exit' detach instead of killing the session
if [[ -n "$ZELLIJ" ]]; then
    alias exit='zellij action detach'
fi

# Auto-attach to Zellij on SSH with remote theme
if [[ -n "$SSH_CONNECTION" ]] && [[ -z "$ZELLIJ" ]] && command -v zellij &>/dev/null; then
    export ZELLIJ_CONFIG_DIR="$HOME/.config/zellij-remote"
    zellij attach --create default
    exit
fi
