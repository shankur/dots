# ── History ──────────────────────────────────────────────────────────────
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS

{{ if eq .chezmoi.os "darwin" -}}
# ── Homebrew ─────────────────────────────────────────────────────────────
# PATH is set in .zshenv; this loads completions/env vars for interactive shells.
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}

# Fall back to xterm-256color if the terminal type is unknown to this system
if [[ -n "$TERM" ]] && ! infocmp "$TERM" &>/dev/null 2>&1; then
    export TERM=xterm-256color
fi

# Source credential/env files if they exist
for f in ~/.awscredentials ~/.jenkinstoken ~/.atlassian ~/.snowflaketoken ~/.ghtoken; do
    [ -f "$f" ] && source "$f"
done

# ── Completion ───────────────────────────────────────────────────────────
# fzf completion must load before compinit
{{- if eq .chezmoi.os "darwin" }}
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
{{- else }}
[ -f ~/.config/fzf/completion.zsh ] && source ~/.config/fzf/completion.zsh
{{- end }}

fpath=(~/.zsh/completions $fpath)

autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*:match:*' original only
zstyle ':completion:*:approximate:*' max-errors 1 numeric
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path ~/.zsh/cache

# fzf-tab: replace the completion menu with fzf (after compinit, before other plugins)
[ -f ~/.config/fzf-tab/fzf-tab.plugin.zsh ] && source ~/.config/fzf-tab/fzf-tab.plugin.zsh

# zsh-autosuggestions / zsh-syntax-highlighting, if installed
{{- if eq .chezmoi.os "darwin" }}
[[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- else }}
for f in \
    ~/.nix-profile/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
    /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
    /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
; do
    [[ -f "$f" ]] && { source "$f"; break }
done
for f in \
    ~/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
; do
    [[ -f "$f" ]] && { source "$f"; break }
done
{{- end }}

# git-extras completions
{{- if eq .chezmoi.os "darwin" }}
[[ -f /opt/homebrew/opt/git-extras/share/git-extras/git-extras-completion.zsh ]] && \
    source /opt/homebrew/opt/git-extras/share/git-extras/git-extras-completion.zsh
{{- else }}
for f in /usr/share/git-extras/git-extras-completion.zsh /usr/local/share/git-extras/git-extras-completion.zsh; do
    [[ -f "$f" ]] && { source "$f"; break }
done
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
# fzf key bindings (completion was already sourced above, before compinit)
[ -f ~/.config/fzf/key-bindings.zsh ] && source ~/.config/fzf/key-bindings.zsh
{{- end }}

bindkey '^I' expand-or-complete
bindkey '^[[Z' reverse-menu-complete
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char
bindkey '^L' clear-screen

# ── Aliases & tools ──────────────────────────────────────────────────────
alias n='nvim'
alias v='nvim'
alias vim='nvim'

setopt COMPLETE_ALIASES
alias ls='eza --color=always --group-directories-first --icons'
alias ll='eza -l --color=always --group-directories-first --icons'
alias la='eza -la --color=always --group-directories-first --icons'
alias lt='eza -T --color=always --group-directories-first --icons'
alias l.='eza -a | command grep -E "^\."'
command -v fd &>/dev/null && alias find='fd'
command -v fdfind &>/dev/null && alias find='fdfind'
alias grep='rg'

if command -v zoxide &> /dev/null; then
    export _ZO_DOCTOR=0
    eval "$(zoxide init zsh --cmd cd)"
    alias z='cd'
fi

if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

export DISABLE_AUTOUPDATER=1

# Report working directory to the terminal via OSC 7 (new tab/split opens in the same dir)
autoload -Uz add-zsh-hook
__osc7_cwd() {
    printf '\e]7;file://%s%s\e\\' "$HOST" "${PWD// /%20}"
}
add-zsh-hook chpwd __osc7_cwd
__osc7_cwd

# Sync AI knowledge repos (ai-history + claude-kb)
sync-ai() {
    local failed=0
    for repo in ~/ai-history ~/claude-kb; do
        [[ -d "$repo/.git" ]] || continue
        local name=$(basename "$repo")
        echo "--- $name ---"
        git -C "$repo" add -A
        if git -C "$repo" diff --cached --quiet; then
            echo "nothing to commit"
            continue
        fi
        local msg
        msg=$(git -C "$repo" diff --cached --stat | claude -p \
            "Write a short git commit message (1 line, no quotes) summarizing these changes to my $name repo. Just the message, nothing else." 2>/dev/null) \
            || msg="sync $(date +%Y-%m-%d/%H:%M)"
        echo "commit: $msg"
        git -C "$repo" commit -m "$msg" && \
        git -C "$repo" push || { echo "FAILED: $repo"; failed=1; }
    done
    return $failed
}

# ── Zellij ───────────────────────────────────────────────────────────────
alias zj="zellij"
compdef _zellij zj 2>/dev/null
if command -v zellij &>/dev/null; then
    mkdir -p ~/.zsh/completions
    zellij setup --generate-completion zsh > ~/.zsh/completions/_zellij
    fpath=(~/.zsh/completions $fpath)
fi

if [[ -n "$ZELLIJ" ]]; then
    # Inside zellij: make 'exit' detach instead of killing the session
    alias exit='zellij action detach'
    # Block SSH from within Zellij to prevent nested sessions
    ssh() { echo "Detach from Zellij first (exit) before using SSH."; return 1; }
fi

{{- if eq .profile "work" }}

# ── Work (Snowflake) ─────────────────────────────────────────────────────
eval "$(sf aliases)"

# Refresh the forwarded GitHub ssh-agent on a Snowflake cloud workspace.
# The sfcli ssh config forwards $SSH_AUTH_SOCK to /dev/shm/ssh-agent-$USER.sock
# on the remote, but a persisted ControlMaster (ControlPersist 8h) can pin a
# now-dead local agent socket, breaking git / `sf __ssh` auth with
# "Permission denied (publickey)". This rebinds the forward to the current
# agent without restarting the master, so multiplexed sessions stay connected.
gh-agent-refresh() {
  local host="${1:-alice}"
  if [[ -z "$SSH_AUTH_SOCK" ]]; then
    echo "gh-agent-refresh: no SSH_AUTH_SOCK in this shell" >&2
    return 1
  fi
  ssh -O cancel -R "/dev/shm/ssh-agent-$USER.sock" "$host" 2>/dev/null
  ssh "$host" -- "rm -f /dev/shm/ssh-agent-$USER.sock" 2>/dev/null
  ssh -O forward -R "/dev/shm/ssh-agent-$USER.sock:$SSH_AUTH_SOCK" "$host" || {
    echo "gh-agent-refresh: forward failed for $host" >&2
    return 1
  }
  ssh "$host" -- 'zsh -lc "sf auth check"' 2>&1 | grep -i github
}
{{ end }}

# Added by sf setup
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

# Added by sf setup
export PATH="$HOME/.local/bin:$PATH"

# Cortex CLI completion (disable via /settings in cortex)
[[ -s ~/.zsh/completions/cortex.zsh ]] && source ~/.zsh/completions/cortex.zsh
