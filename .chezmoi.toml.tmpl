{{- $profile := "personal" -}}
{{- $name := "Ankur Sharma" -}}
{{- $email := "" -}}

{{- /* Detect profile based on hostname */ -}}
{{- if contains "snowflake" .chezmoi.hostname -}}
{{-   $profile = "work" -}}
{{- else if contains "sf-" .chezmoi.hostname -}}
{{-   $profile = "work" -}}
{{- else if contains "alice" .chezmoi.hostname -}}
{{-   $profile = "work" -}}
{{- end -}}

{{- /* Prompt for profile if not auto-detected */ -}}
{{- if stdinIsATTY -}}
{{-   $profile = promptString "profile" $profile -}}
{{- end -}}

{{- /* Set email based on profile */ -}}
{{- if eq $profile "work" -}}
{{-   $email = "ankur.sharma@snowflake.com" -}}
{{- else -}}
{{-   $email = "inbox.ankur@pm.me" -}}
{{- end -}}

{{- /* Prompt for name if needed */ -}}
{{- if stdinIsATTY -}}
{{-   $name = promptString "name" $name -}}
{{- end -}}

[data]
    profile = {{ $profile | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
