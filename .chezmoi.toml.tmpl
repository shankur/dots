encryption = "age"
[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    recipient = "age1h9axv0t00zwnnkfem20pfzjzwy7sq4dww5j8lp0etkha27mt2essdld6l2"

[data]
    profile = "{{ promptChoiceOnce . "profile" "Profile" (list "work" "personal") "work" }}"
    name = "{{ promptStringOnce . "name" "Your full name" }}"
    email = "{{ promptStringOnce . "email" "Your email" }}"
    ai_history_repo = "{{ promptStringOnce . "ai_history_repo" "AI history git repo URL" }}"
    claude_kb_repo = "{{ promptStringOnce . "claude_kb_repo" "Claude KB plugin git repo URL (leave empty to skip)" }}"
{{- if hasKey . "claude_sessions" }}

[data.claude_sessions]
{{ .claude_sessions | toToml -}}
{{- end }}
{{- if hasKey . "snowdash" }}

[data.snowdash]
{{ .snowdash | toToml -}}
{{- end }}
