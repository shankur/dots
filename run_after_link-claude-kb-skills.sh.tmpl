#!/bin/bash
# Symlink claude-kb skills into ~/.claude/skills/
# hash: {{ joinPath .chezmoi.homeDir "claude-kb" "skills" | glob | join "," }}
set -e

SKILLS_DIR="$HOME/.claude/skills"
KB_SKILLS="$HOME/claude-kb/skills"

# Only run if claude-kb exists
if [ ! -d "$KB_SKILLS" ]; then
    exit 0
fi

# Symlink each skill from claude-kb that isn't already present as a real dir
for skill in "$KB_SKILLS"/*/; do
    name=$(basename "$skill")
    target="$SKILLS_DIR/$name"

    # Skip if a real (non-symlink) directory exists (chezmoi-managed)
    if [ -d "$target" ] && [ ! -L "$target" ]; then
        continue
    fi

    # Create or update symlink
    ln -sfn "$skill" "$target"
done
