# macOS Finder metadata — never chezmoi-managed
.DS_Store
**/.DS_Store

{{- if ne .chezmoi.os "darwin" }}
# wt is a local Mac CLI for driving cloud workspaces; never deploy to Linux hosts.
.local/bin/wt
# VSCode GUI settings are macOS-only here; Linux cloud workspaces use Remote/server settings.
Library/Application Support/Code/**
{{- end }}

{{- if eq .profile "personal" }}
# Personal machines skip the curated projects list entirely — gen-projects-workspace
# falls back to tracking every git repo it finds under ~/Projects when this is absent,
# which is exactly what we want without needing to keep a personal list in sync.
.config/projects-workspace/repos
{{- end }}

# codex: manage only AGENTS.md — never runtime state, machine/Koi-managed config, or secrets
.codex/*.sqlite*
.codex/sessions
.codex/shell_snapshots
.codex/skills
.codex/tmp
.codex/.tmp
.codex/logs*
.codex/history.jsonl
.codex/config.toml
.codex/hooks.json
.codex/installation_id
.codex/.personality_migration
.codex/.sfc_prodsec_ai_policy_accepted
.codex/goals_*
.codex/memories_*
.codex/state_*
