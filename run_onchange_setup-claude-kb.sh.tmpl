{{ if eq .chezmoi.os "darwin" -}}
{{ $repo := "" }}{{ if hasKey . "claude_kb_repo" }}{{ $repo = .claude_kb_repo }}{{ end }}#!/bin/bash
# Clone claude-kb plugin repo (macOS only — cloud workspaces are ephemeral, no local KB checkout needed there)
# repo: {{ $repo }}
set -e

DEST="$HOME/claude-kb"
REPO="{{ $repo }}"

if [ -z "$REPO" ]; then
    echo "claude_kb_repo not set in chezmoi config, skipping"
    exit 0
fi

if [ -d "$DEST" ]; then
    REMOTE=$(git -C "$DEST" remote get-url origin 2>/dev/null)
    if [ "$REMOTE" != "$REPO" ]; then
        echo "FATAL: $DEST exists but remote ($REMOTE) does not match expected ($REPO)" >&2
        exit 1
    fi
    echo "claude-kb already cloned"
else
    if ! git clone "$REPO" "$DEST" 2>&1; then
        echo "WARNING: Could not clone claude-kb repo (no SSH keys or network access?). Skipping."
        exit 0
    fi
    echo "claude-kb repo cloned to $DEST"
fi

# Run setup.sh if it exists
if [ -f "$DEST/setup.sh" ]; then
    echo "Running claude-kb setup.sh..."
    (cd "$DEST" && bash setup.sh)
    echo "claude-kb setup complete"
fi
{{ end -}}
