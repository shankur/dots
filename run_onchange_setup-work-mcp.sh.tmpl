{{ if eq .profile "work" -}}
#!/bin/bash
# Setup Snowflake MCP servers for work profile
# hash: {{ include "run_onchange_setup-work-mcp.sh.tmpl" | sha256sum }}

set -e

echo "🔧 Setting up Snowflake MCP servers..."

# Check if sf command is available
if ! command -v sf &> /dev/null; then
    echo "⚠️  sf CLI not found, skipping MCP setup"
    exit 0
fi

# Change to Snowflake trunk directory
TRUNK_DIR="$HOME/Snowflake/trunk"
if [ ! -d "$TRUNK_DIR" ]; then
    echo "⚠️  $TRUNK_DIR not found, skipping MCP setup"
    exit 0
fi

cd "$TRUNK_DIR"

# List of MCP tools to add
MCP_TOOLS=(
    "confluence"
    "jira"
    "jira_wo"
    "snowci"
    "snowhouse"
    "github"
    "graphite"
    "buildkite"
    "glean"
    "jenkins"
)

for tool in "${MCP_TOOLS[@]}"; do
    echo "  → Adding MCP server: $tool"
    sf __mcp add "$tool" 2>/dev/null || echo "    ⚠️  Failed to add $tool (may already exist)"
done

# Add jvm-debug-bridge MCP server (cloud workspaces only)
{{- if ne .chezmoi.os "darwin" }}
JVM_DEBUG_JAR="$HOME/Snowflake/trunk/Varia/jvm-debug-bridge/target/jvm-debug-bridge-1.0.0-SNAPSHOT.jar"
if [ -f "$HOME/.mcp.json" ]; then
    # Add jvm-debug server if not already present
    if ! grep -q "jvm-debug" "$HOME/.mcp.json"; then
        echo "  → Adding MCP server: jvm-debug"
        TMP=$(mktemp)
        python3 -c "
import json
with open('$HOME/.mcp.json') as f:
    data = json.load(f)
data['mcpServers']['jvm-debug'] = {
    'command': 'java',
    'args': ['--add-modules', 'jdk.jdi', '-jar', '$JVM_DEBUG_JAR']
}
with open('$TMP', 'w') as f:
    json.dump(data, f, indent=2)
" && mv "$TMP" "$HOME/.mcp.json"
    fi
fi
{{- end }}

echo "✅ MCP servers configured"
{{ end -}}
