{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Clone ai-history repo (macOS only — cloud workspaces are ephemeral, no local history needed there)
# repo: {{ .ai_history_repo }}
set -e

DEST="$HOME/ai-history"
REPO="{{ .ai_history_repo }}"

if [ -z "$REPO" ]; then
    echo "ai_history_repo not set in chezmoi config, skipping"
    exit 0
fi

if [ -d "$DEST" ]; then
    REMOTE=$(git -C "$DEST" remote get-url origin 2>/dev/null || true)
    if [ -n "$REMOTE" ] && [ "$REMOTE" != "$REPO" ]; then
        echo "FATAL: $DEST exists but remote ($REMOTE) does not match expected ($REPO)" >&2
        exit 1
    fi
    echo "ai-history already cloned"
else
    if ! git clone "$REPO" "$DEST" 2>&1; then
        echo "WARNING: Could not clone ai-history repo (no SSH keys or network access?). Skipping."
        exit 0
    fi
    echo "ai-history repo cloned to $DEST"
fi

# Run setup.sh if it exists. This only configures ai-history's local git hooks,
# which is non-essential — never let its failure abort the whole chezmoi apply.
if [ -f "$DEST/setup.sh" ]; then
    echo "Running ai-history setup.sh..."
    if (cd "$DEST" && bash setup.sh); then
        echo "ai-history setup complete"
    else
        rc=$?
        echo "WARNING: ai-history setup.sh failed (exit $rc) — skipping hook setup, not blocking chezmoi" >&2
    fi
fi
{{ end -}}
