#!/bin/bash
# Set up worktree-based development for the snowflake monorepo
# layout: snowflake-worktree/main/code (base), snowflake-worktree/worktree-<name>/{code,artifacts}
# hash: v3
{{ if ne .profile "work" }}
echo "Skipping worktree setup (not work profile)"
exit 0
{{ end }}
{{ if eq .chezmoi.os "darwin" }}
echo "Skipping worktree setup (not a cloud workspace)"
exit 0
{{ end }}
set -e

ROOT="/home/repo/snowflake-worktree"
MAIN_CODE="$ROOT/main/code"
MAIN_ARTIFACTS="$ROOT/main/artifacts"
MOUNT="/home/repo/snowflake"
SF_MOUNT="$HOME/sf"
TRUNK="$HOME/Snowflake/trunk"

# Old paths (for migration)
OLD_BASE="/home/repo/snowflake-base"
OLD_SF_BASE="$HOME/sf-base"

# Already set up?
if [ -d "$MAIN_CODE/.git" ]; then
    echo "Worktree layout already in place"
    exit 0
fi

# Migrate from old layout if present
if [ -d "$OLD_BASE/.git" ]; then
    echo "Migrating from old layout..."
    mkdir -p "$ROOT/main"
    mv "$OLD_BASE" "$MAIN_CODE"
    echo "Moved $OLD_BASE -> $MAIN_CODE"

    if [ -d "$OLD_SF_BASE" ]; then
        mv "$OLD_SF_BASE" "$MAIN_ARTIFACTS"
        echo "Moved $OLD_SF_BASE -> $MAIN_ARTIFACTS"
    else
        mkdir -p "$MAIN_ARTIFACTS"
    fi

# Fresh setup from existing mount
elif [ -d "$MOUNT/.git" ]; then
    echo "Setting up worktree layout from $MOUNT..."
    mkdir -p "$ROOT/main"
    mv "$MOUNT" "$MAIN_CODE"
    echo "Moved $MOUNT -> $MAIN_CODE"

    if [ -d "$SF_MOUNT" ]; then
        mv "$SF_MOUNT" "$MAIN_ARTIFACTS"
        echo "Moved $SF_MOUNT -> $MAIN_ARTIFACTS"
    else
        mkdir -p "$MAIN_ARTIFACTS"
    fi

else
    echo "WARNING: No existing repo found at $MOUNT or $OLD_BASE. Skipping."
    exit 0
fi

# Create mount points
echo "Creating mount points..."
mkdir -p "$MOUNT" "$SF_MOUNT" "$TRUNK"

# Initial bind mounts
echo "Bind-mounting main..."
sudo mount --bind "$MAIN_CODE"      "$MOUNT"
sudo mount --bind "$MAIN_ARTIFACTS" "$SF_MOUNT"
sudo mount --bind "$MAIN_CODE"      "$TRUNK"
ln -sfn "$MOUNT" "$TRUNK"

echo ""
echo "Worktree layout ready:"
echo "  Main code:   $MAIN_CODE"
echo "  Main arts:   $MAIN_ARTIFACTS"
echo "  Mount:       $MOUNT  (-> main/code)"
echo "  SF mount:    $SF_MOUNT (-> main/artifacts)"
echo "  Trunk:       $TRUNK"
echo ""
echo "Use 'worktree create <name> --remote <host>' from your Mac to get started"
