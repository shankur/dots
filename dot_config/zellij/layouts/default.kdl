layout {
    pane split_direction="vertical" {
        pane
    }

    pane size=1 borderless=true {
        plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
            // Catppuccin Mocha
            // base=#1e1e2e surface0=#313244 surface1=#45475a surface2=#585b70
            // text=#cdd6f4 subtext1=#bac2de overlay1=#7f849c
            // blue=#89b4fa lavender=#b4befe mauve=#cba6f7
            // green=#a6e3a1 teal=#94e2d5 sky=#89dceb
            // peach=#fab387 yellow=#f9e2af red=#f38ba8

            format_left   "#[fg=#89b4fa,bold] {session} #[fg=#45475a]│#[fg=#cdd6f4] {mode}"
            format_center "{tabs}"
            format_right  "#[fg=#45475a]│#[fg=#a6e3a1] 󰃰 {datetime}#[fg=#45475a] │#[fg=#89b4fa]  {swap_layout} "
            format_space  ""

            mode_normal        "#[fg=#a6e3a1,bold]  NORMAL "
            mode_locked        "#[fg=#f38ba8,bold]  LOCKED "
            mode_resize        "#[fg=#fab387,bold]  RESIZE "
            mode_pane          "#[fg=#89b4fa,bold]  PANE "
            mode_tab           "#[fg=#cba6f7,bold]  TAB "
            mode_scroll        "#[fg=#f9e2af,bold]  SCROLL "
            mode_enter_search  "#[fg=#94e2d5,bold]  SEARCH "
            mode_search        "#[fg=#94e2d5,bold]  SEARCH "
            mode_rename_tab    "#[fg=#cba6f7,bold]  RENAME "
            mode_rename_pane   "#[fg=#89b4fa,bold]  RENAME "
            mode_session       "#[fg=#f5c2e7,bold]  SESSION "
            mode_move          "#[fg=#fab387,bold]  MOVE "
            mode_prompt        "#[fg=#94e2d5,bold]  PROMPT "
            mode_tmux          "#[fg=#f38ba8,bold]  TMUX "
            mode_default_to_mode "normal"

            tab_normal   "#[fg=#45475a] #[fg=#7f849c]{index} #[fg=#bac2de]{name} {floating_indicator}#[fg=#45475a] "
            tab_active   "#[fg=#45475a] #[fg=#89b4fa,bold]{index} #[fg=#cdd6f4,bold]{name} {floating_indicator}#[fg=#45475a] "

            tab_fullscreen_indicator  "󰊓 "
            tab_floating_indicator    "󰉈 "
            tab_sync_indicator        " "

            datetime          "{format}"
            datetime_format   "%a %b %d %H:%M"
            datetime_timezone "America/New_York"
        }
    }
}
