{{- if eq .chezmoi.os "darwin" }}
-- Claude Sessions Manager
return {
  {
    "shankur/multi-claude.nvim",
    cmd = { "ClaudeSessions", "ClaudeNew", "ClaudeResume", "ClaudeClose", "ClaudeNext", "ClaudePrev", "ClaudeList", "ClaudeClean", "ClaudeDiscover", "ClaudeJump", "ClaudeJump1", "ClaudeJump2", "ClaudeJump3", "ClaudeJump4", "ClaudeJump5" },
    keys = {
      { "<leader>cn", "<cmd>ClaudeNew<cr>", desc = "New Claude Session" },
      { "<leader>cr", "<cmd>ClaudeResume<cr>", desc = "Resume Claude Session" },
      { "<leader>cN", "<cmd>ClaudeNext<cr>", desc = "Next Claude Session" },
      { "<leader>cP", "<cmd>ClaudePrev<cr>", desc = "Prev Claude Session" },
      { "<leader>cc", "<cmd>ClaudeDiscover<cr>", desc = "Discover Remote Sessions" },
      { "<leader>cx", "<cmd>ClaudeClean<cr>", desc = "Clean Claude Sessions" },
      { "<leader>cq", "<cmd>ClaudeClose<cr>", desc = "Close Claude Session" },
      { "<leader>cj", "<cmd>ClaudeJump<cr>", desc = "Jump to Session" },
      { "<leader>c1", "<cmd>ClaudeJump1<cr>", desc = "Jump to Session 1" },
      { "<leader>c2", "<cmd>ClaudeJump2<cr>", desc = "Jump to Session 2" },
      { "<leader>c3", "<cmd>ClaudeJump3<cr>", desc = "Jump to Session 3" },
      { "<leader>c4", "<cmd>ClaudeJump4<cr>", desc = "Jump to Session 4" },
      { "<leader>c5", "<cmd>ClaudeJump5<cr>", desc = "Jump to Session 5" },
    },
    opts = {
{{- if ne .profile "work" }}
      claude_args = { "--model", "claude-sonnet-4-6" },
{{- end }}
      default_cwd = "~",
      cwd_paths = {
        "~",
{{- if hasKey . "claude_sessions" }}
        "{{ .claude_sessions.cwd }}",
{{- if hasKey .claude_sessions "cwd_paths" }}
{{- range .claude_sessions.cwd_paths }}
        "{{ . }}",
{{- end }}
{{- end }}
{{- end }}
      },
      hosts = {
{{- if hasKey . "claude_sessions" }}
{{- range .claude_sessions.hosts }}
        { name = "{{ . }}", addr = "{{ $.claude_sessions.username }}@{{ . }}", cwd = "{{ $.claude_sessions.cwd }}", model = "{{ $.claude_sessions.model }}" },
{{- end }}
{{- end }}
      },
    },
    config = function(_, opts)
      require("claude-sessions").setup(opts)
    end,
  },
}
{{- else }}
-- Claude Sessions Manager (disabled on remote servers)
return {}
{{- end }}
