#!/bin/bash
# Manage snowflake monorepo worktrees with bind-mount activation for build/deploy/test
#
# Usage:
#   worktree create <name> [base-branch]   Create a new worktree (default base: main)
#   worktree activate <name>               Bind-mount worktree at /home/repo/snowflake
#   worktree deactivate                    Unmount, restore base repo
#   worktree status                        Show current mount and active worktree
#   worktree list                          List all worktrees
#   worktree remove <name>                 Remove a worktree
#   worktree build <name> <bazel-args...>  Activate + bazel build + deactivate

set -e

BASE="/home/repo/snowflake-base"
MOUNT="/home/repo/snowflake"
WORKTREES="/home/repo/worktrees"

SF_BASE="$HOME/sf-base"
SF_MOUNT="$HOME/sf"
SF_WORKTREES="$HOME/sf-worktrees"

TRUNK="$HOME/Snowflake/trunk"

LOCKFILE="/tmp/worktree-activate.lock"
ACTIVEFILE="/tmp/worktree-active"

die() { echo "error: $*" >&2; exit 1; }

# Acquire exclusive lock. With --force, stops current deployment first.
# Without --force, fails if another worktree is active.
acquire_lock() {
    local force="${1:-false}"
    exec 9>"$LOCKFILE"
    if ! flock -n 9; then
        local current
        current=$(cat "$ACTIVEFILE" 2>/dev/null || echo "unknown")
        if [ "$force" = true ]; then
            echo "Force-acquiring lock from active worktree '$current'..."
            echo "Stopping deployment..."
            sf sut stop 2>/dev/null || true
            flock 9
        else
            die "Worktree '$current' is currently active. Use --force to override."
        fi
    fi
}

# Release lock and clear active file
release_lock() {
    rm -f "$ACTIVEFILE"
    flock -u 9 2>/dev/null || true
}

# Check layout
check_layout() {
    [ -d "$BASE/.git" ] || die "Base repo not found at $BASE. Run 'chezmoi apply' first."
    [ -d "$WORKTREES" ] || die "Worktrees directory not found at $WORKTREES. Run 'chezmoi apply' first."
}

# What's currently mounted?
get_active() {
    if mountpoint -q "$MOUNT" 2>/dev/null; then
        findmnt -n -o SOURCE "$MOUNT" 2>/dev/null || echo "(mounted, source unknown)"
    else
        echo ""
    fi
}

cmd_create() {
    local name="$1"
    local base="${2:-main}"
    [ -n "$name" ] || die "Usage: worktree create <name> [base-branch]"
    check_layout

    local wt="$WORKTREES/$name"
    [ ! -d "$wt" ] || die "Worktree already exists: $wt"

    echo "Creating worktree '$name' from '$base'..."
    cd "$BASE"
    git worktree add "$wt" -b "$name" "$base"

    # Create corresponding sf directory for build artifacts/logs
    mkdir -p "$SF_WORKTREES/$name"
    echo "Created sf directory: $SF_WORKTREES/$name"

    # Symlink project-local MCP config from base into worktree
    if [ -f "$BASE/.mcp.json" ]; then
        ln -sf "$BASE/.mcp.json" "$wt/.mcp.json"
        echo "Linked .mcp.json into worktree"
    fi

    # Build MCP plugin from worktree
    if [ -d "$wt/Varia/jvm-debug-bridge" ]; then
        echo "Building jvm-debug-bridge MCP plugin..."
        (cd "$wt/Varia/jvm-debug-bridge" && mvn clean package -q)
    fi

    echo ""
    echo "Worktree created at: $wt"
    echo "To activate for build: worktree activate $name"
}

cmd_activate() {
    local force=false
    local name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=true; shift ;;
            *) name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "Usage: worktree activate [--force] <name>"
    check_layout

    local wt="$WORKTREES/$name"
    [ -d "$wt" ] || die "Worktree not found: $wt"

    acquire_lock "$force"

    # Ensure sf worktree dir exists
    mkdir -p "$SF_WORKTREES/$name"

    # Unmount current if mounted
    if mountpoint -q "$MOUNT" 2>/dev/null; then
        echo "Stopping any running deployment..."
        sf sut stop 2>/dev/null || true
        echo "Unmounting current bind mount..."
        sudo umount -l "$MOUNT"
    fi
    if mountpoint -q "$SF_MOUNT" 2>/dev/null; then
        sudo umount -l "$SF_MOUNT"
    fi
    if mountpoint -q "$TRUNK" 2>/dev/null; then
        sudo umount -l "$TRUNK"
    fi

    echo "Activating worktree '$name'..."
    sudo mount --bind "$wt" "$MOUNT"
    sudo mount --bind "$SF_WORKTREES/$name" "$SF_MOUNT"
    sudo mount --bind "$wt" "$TRUNK"
    echo "Mounted: $wt -> $MOUNT"
    echo "Mounted: $SF_WORKTREES/$name -> $SF_MOUNT"
    echo "Mounted: $wt -> $TRUNK"

    # Record active worktree
    echo "$name" > "$ACTIVEFILE"

    # Allow direnv for all mount points
    direnv allow "$MOUNT" 2>/dev/null || true
    direnv allow "$TRUNK" 2>/dev/null || true

    echo ""
    echo "Ready to build/deploy/test from /home/repo/snowflake"
}

cmd_deactivate() {
    check_layout

    if ! mountpoint -q "$MOUNT" 2>/dev/null; then
        echo "Nothing is mounted at $MOUNT"
        return
    fi

    echo "Stopping deployment..."
    sf sut stop 2>/dev/null || true

    echo "Unmounting $MOUNT..."
    sudo umount -l "$MOUNT"
    if mountpoint -q "$SF_MOUNT" 2>/dev/null; then
        echo "Unmounting $SF_MOUNT..."
        sudo umount -l "$SF_MOUNT"
    fi
    if mountpoint -q "$TRUNK" 2>/dev/null; then
        echo "Unmounting $TRUNK..."
        sudo umount -l "$TRUNK"
    fi

    # Restore base repo and sf as default
    echo "Restoring base mounts..."
    sudo mount --bind "$BASE" "$MOUNT"
    sudo mount --bind "$SF_BASE" "$SF_MOUNT"
    sudo mount --bind "$BASE" "$TRUNK"
    echo "Restored: $BASE -> $MOUNT"
    echo "Restored: $SF_BASE -> $SF_MOUNT"
    echo "Restored: $BASE -> $TRUNK"

    release_lock
}

cmd_status() {
    check_layout

    echo "Layout:"
    echo "  Base repo:   $BASE"
    echo "  Base sf:     $SF_BASE"
    echo "  Worktrees:   $WORKTREES/"
    echo "  SF worktrees: $SF_WORKTREES/"
    echo "  Mount point: $MOUNT"
    echo "  SF mount:    $SF_MOUNT"
    echo "  Trunk:       $TRUNK"
    echo ""

    if mountpoint -q "$MOUNT" 2>/dev/null; then
        local src
        src=$(findmnt -n -o SOURCE "$MOUNT" 2>/dev/null)
        echo "Active mount: $src -> $MOUNT"

        if [ "$src" = "$BASE" ]; then
            echo "  (base repo is active — no worktree activated)"
        else
            local name
            name=$(basename "$src")
            echo "  Worktree: $name"
        fi
    else
        echo "Nothing mounted at $MOUNT"
    fi

    if mountpoint -q "$SF_MOUNT" 2>/dev/null; then
        local sf_src
        sf_src=$(findmnt -n -o SOURCE "$SF_MOUNT" 2>/dev/null)
        echo "SF mount: $sf_src -> $SF_MOUNT"
    fi
}

cmd_list() {
    check_layout
    echo "Worktrees:"
    cd "$BASE"
    git worktree list
    echo ""

    local active
    active=$(get_active)
    if [ -n "$active" ]; then
        echo "Currently mounted: $active -> $MOUNT"
    fi
}

cmd_remove() {
    local force=false
    local name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=true; shift ;;
            *) name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "Usage: worktree remove [--force] <name>"
    check_layout

    local wt="$WORKTREES/$name"
    [ -d "$wt" ] || die "Worktree not found: $wt"

    # Check if this worktree is currently mounted
    if mountpoint -q "$MOUNT" 2>/dev/null; then
        local src
        src=$(findmnt -n -o SOURCE "$MOUNT" 2>/dev/null)
        if [ "$src" = "$wt" ]; then
            echo "Worktree '$name' is currently active. Stopping deployment and deactivating..."
            sf sut stop 2>/dev/null || true
            cmd_deactivate
        fi
    fi

    echo "Removing worktree '$name'..."
    cd "$BASE"
    if [ "$force" = true ]; then
        git worktree remove --force "$wt"
    else
        git worktree remove "$wt"
    fi

    # Remove corresponding sf directory
    if [ -d "$SF_WORKTREES/$name" ]; then
        sudo rm -rf "$SF_WORKTREES/$name"
        echo "Removed sf directory: $SF_WORKTREES/$name"
    fi

    echo "Removed: $wt"
}

cmd_init() {
    check_layout

    # If mounted, check if it's base or an active worktree
    if mountpoint -q "$MOUNT" 2>/dev/null; then
        local src
        src=$(findmnt -n -o SOURCE "$MOUNT" 2>/dev/null)
        if [ "$src" = "$BASE" ]; then
            echo "Base already mounted at $MOUNT"
            return
        fi
        # A worktree is active — deactivate it first
        echo "Active worktree detected ($src), deactivating..."
        cmd_deactivate
        return
    fi

    # Clean up stale state from before reboot
    if [ -f "$ACTIVEFILE" ]; then
        local stale
        stale=$(cat "$ACTIVEFILE" 2>/dev/null)
        echo "Clearing stale active worktree '$stale' (lost on reboot)"
        rm -f "$ACTIVEFILE"
        rm -f "$LOCKFILE"
    fi

    echo "Restoring base bind mounts..."
    sudo mount --bind "$BASE" "$MOUNT"
    sudo mount --bind "$SF_BASE" "$SF_MOUNT"
    sudo mount --bind "$BASE" "$TRUNK"
    echo "Mounted: $BASE -> $MOUNT"
    echo "Mounted: $SF_BASE -> $SF_MOUNT"
    echo "Mounted: $BASE -> $TRUNK"

    direnv allow "$MOUNT" 2>/dev/null || true
    direnv allow "$TRUNK" 2>/dev/null || true
}

cmd_build() {
    local name="$1"
    [ -n "$name" ] || die "Usage: worktree build <name> <bazel-args...>"
    shift

    cmd_activate "$name"
    echo ""
    echo "Running: tools/bazel $*"
    cd "$MOUNT"
    tools/bazel "$@"
}

# Dispatch
case "${1:-}" in
    init)       shift; cmd_init "$@" ;;
    create)     shift; cmd_create "$@" ;;
    activate)   shift; cmd_activate "$@" ;;
    deactivate) shift; cmd_deactivate "$@" ;;
    status)     shift; cmd_status "$@" ;;
    list)       shift; cmd_list "$@" ;;
    ls)         shift; cmd_list "$@" ;;
    remove)     shift; cmd_remove "$@" ;;
    rm)         shift; cmd_remove "$@" ;;
    build)      shift; cmd_build "$@" ;;
    *)
        echo "Usage: worktree <command> [args]"
        echo ""
        echo "Commands:"
        echo "  init                   Restore base bind mounts (run after reboot)"
        echo "  create <name> [base]   Create a new worktree (default base: main)"
        echo "  activate <name>        Bind-mount worktree for build/deploy/test"
        echo "  deactivate             Unmount worktree, restore base repo"
        echo "  status                 Show current mount state"
        echo "  list                   List all worktrees"
        echo "  remove <name>          Remove a worktree"
        echo "  build <name> <args>    Activate + bazel build + deactivate"
        ;;
esac
