#!/bin/bash
# Manage snowflake monorepo worktrees with bind-mount activation for build/deploy/test
#
# Local (Mac) commands — run from your laptop:
#   worktree create <name> --remote <host> [base-branch]
#   worktree deploy <name>
#   worktree sync
#   worktree ls
#   worktree activate <name>      (SSHes to remote)
#   worktree deactivate           (SSHes to remote)
#   worktree force-reset          (SSHes to remote)
#   worktree remove <name>        (SSHes to remote)
#
# Remote (Linux) commands — called directly or via SSH:
#   worktree remote-activate <name>
#   worktree remote-deactivate
#   worktree remote-force-reset
#   worktree remote-init
#   worktree remote-status
#   worktree remote-create <name>
#   worktree remote-remove <name>

set -euo pipefail

# ── Remote layout (Linux) ──────────────────────────────────────────────────────
REMOTE_ROOT="/home/repo/snowflake-worktree"
REMOTE_MAIN="$REMOTE_ROOT/main"
REMOTE_MOUNT="/home/repo/snowflake"
REMOTE_SF_MOUNT="$HOME/sf"
REMOTE_TRUNK="$HOME/Snowflake/trunk"
REMOTE_LOCK="$REMOTE_ROOT/.lock"

# ── Local layout (Mac) ────────────────────────────────────────────────────────
LOCAL_ROOT="$HOME/Projects/snowflake-worktree"
LOCAL_MAIN="$HOME/Projects/snowflake"          # original clone (never modified directly)
META_DIR="$HOME/.local/share/worktree-meta"

die()  { echo "error: $*" >&2; exit 1; }
info() { echo "==> $*"; }

is_mac()    { [[ "$(uname)" == "Darwin" ]]; }
is_linux()  { [[ "$(uname)" == "Linux" ]]; }

# ── Meta helpers ──────────────────────────────────────────────────────────────

meta_file() { echo "$META_DIR/$1.env"; }

meta_read() {
    local name="$1" key="$2"
    local f; f=$(meta_file "$name")
    [[ -f "$f" ]] || die "No metadata for worktree '$name'. Did you run 'worktree create'?"
    # shellcheck disable=SC1090
    (source "$f" && echo "${!key:-}")
}

meta_write() {
    local name="$1" remote="$2" branch="$3"
    mkdir -p "$META_DIR"
    cat > "$(meta_file "$name")" <<EOF
REMOTE=$remote
BRANCH=$branch
CREATED=$(date +%Y-%m-%d)
EOF
}

meta_delete() {
    local f; f=$(meta_file "$1")
    [[ -f "$f" ]] && rm -f "$f"
}

# ── SSH helper ────────────────────────────────────────────────────────────────

remote_run() {
    local host="$1"; shift
    ssh "$host" "bash -l -c $(printf '%q' "$*")"
}

remote_worktree() {
    local host="$1"; shift
    remote_run "$host" "worktree $*"
}

# ── Lock helpers (remote) ─────────────────────────────────────────────────────

acquire_lock() {
    local name="$1" force="${2:-false}"
    exec 9>"$REMOTE_LOCK"
    if ! flock -n 9; then
        local current
        current=$(cat "$REMOTE_LOCK" 2>/dev/null || echo "unknown")
        if [[ "$force" == true ]]; then
            info "Force-acquiring lock from '$current'..."
            sf sut stop 2>/dev/null || true
            flock 9
        else
            die "Worktree '$current' holds the lock. Use force-reset to override."
        fi
    fi
    echo "$name" > "$REMOTE_LOCK"
}

release_lock() {
    echo "" > "$REMOTE_LOCK"
    flock -u 9 2>/dev/null || true
}

# ── Mount helpers (remote) ────────────────────────────────────────────────────

unmount_all() {
    for mp in "$REMOTE_MOUNT" "$REMOTE_SF_MOUNT" "$REMOTE_TRUNK"; do
        if mountpoint -q "$mp" 2>/dev/null; then
            sudo umount -l "$mp"
        fi
    done
}

mount_worktree() {
    local code_dir="$1" artifacts_dir="$2"
    sudo mount --bind "$code_dir"      "$REMOTE_MOUNT"
    sudo mount --bind "$artifacts_dir" "$REMOTE_SF_MOUNT"
    sudo mount --bind "$code_dir"      "$REMOTE_TRUNK"
    ln -sfn "$REMOTE_MOUNT" "$REMOTE_TRUNK"
    info "Mounted: $code_dir -> $REMOTE_MOUNT"
    info "Mounted: $artifacts_dir -> $REMOTE_SF_MOUNT"
}

# ── Remote commands ───────────────────────────────────────────────────────────

cmd_remote_init() {
    if mountpoint -q "$REMOTE_MOUNT" 2>/dev/null; then
        local src
        src=$(findmnt -n -o SOURCE "$REMOTE_MOUNT" 2>/dev/null || echo "")
        if [[ "$src" == "$REMOTE_MAIN/code" ]]; then
            info "Base already mounted at $REMOTE_MOUNT"
            return
        fi
        info "Active worktree detected, deactivating first..."
        cmd_remote_deactivate
        return
    fi

    # Clear stale lock from before reboot
    if [[ -f "$REMOTE_LOCK" ]] && [[ -s "$REMOTE_LOCK" ]]; then
        info "Clearing stale lock: $(cat "$REMOTE_LOCK")"
        echo "" > "$REMOTE_LOCK"
    fi

    info "Restoring base bind mounts..."
    mount_worktree "$REMOTE_MAIN/code" "$REMOTE_MAIN/artifacts"
}

cmd_remote_status() {
    echo "Remote layout:"
    echo "  Root:        $REMOTE_ROOT"
    echo "  Main code:   $REMOTE_MAIN/code"
    echo "  Main arts:   $REMOTE_MAIN/artifacts"
    echo "  Mount:       $REMOTE_MOUNT"
    echo "  SF mount:    $REMOTE_SF_MOUNT"
    echo "  Trunk:       $REMOTE_TRUNK"
    echo "  Lock:        $REMOTE_LOCK"
    echo ""

    local lock_holder=""
    [[ -f "$REMOTE_LOCK" ]] && lock_holder=$(cat "$REMOTE_LOCK")

    if mountpoint -q "$REMOTE_MOUNT" 2>/dev/null; then
        local src
        src=$(findmnt -n -o SOURCE "$REMOTE_MOUNT" 2>/dev/null || echo "(unknown)")
        echo "Active mount: $src"
        if [[ "$src" == "$REMOTE_MAIN/code" ]]; then
            echo "  State: main (no worktree active)"
        else
            echo "  State: worktree '$(basename "$(dirname "$src")")'"
        fi
    else
        echo "Nothing mounted at $REMOTE_MOUNT"
    fi

    if [[ -n "$lock_holder" ]]; then
        echo "Lock held by: $lock_holder"
    fi

    echo ""
    echo "Worktrees:"
    for d in "$REMOTE_ROOT"/worktree-*/; do
        [[ -d "$d" ]] || continue
        local wname; wname=$(basename "$d")
        echo "  $wname"
        [[ -d "$d/code/.git" ]] && echo "    branch: $(git -C "$d/code" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    done
}

cmd_remote_create() {
    local name="$1"
    [[ -n "$name" ]] || die "Usage: worktree remote-create <name>"
    local wt="$REMOTE_ROOT/worktree-$name"
    [[ ! -d "$wt" ]] || die "Remote worktree already exists: $wt"
    mkdir -p "$wt/code" "$wt/artifacts"
    info "Created remote directories: $wt/{code,artifacts}"
}

cmd_remote_activate() {
    local force=false name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=true; shift ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "Usage: worktree remote-activate [--force] <name>"

    local wt="$REMOTE_ROOT/worktree-$name"
    [[ -d "$wt/code" ]] || die "Remote worktree not found: $wt"

    acquire_lock "$name" "$force"

    info "Stopping any running deployment..."
    sf sut stop 2>/dev/null || true

    unmount_all
    mount_worktree "$wt/code" "$wt/artifacts"
    direnv allow "$REMOTE_MOUNT" 2>/dev/null || true
    direnv allow "$REMOTE_TRUNK" 2>/dev/null || true
    info "Worktree '$name' is now active"
}

cmd_remote_deactivate() {
    acquire_lock "main" false 2>/dev/null || true

    info "Stopping any running deployment..."
    sf sut stop 2>/dev/null || true

    unmount_all
    mount_worktree "$REMOTE_MAIN/code" "$REMOTE_MAIN/artifacts"
    direnv allow "$REMOTE_MOUNT" 2>/dev/null || true
    direnv allow "$REMOTE_TRUNK" 2>/dev/null || true

    release_lock
    info "Restored to main"
}

cmd_remote_force_reset() {
    info "Force-resetting to main (ignoring lock)..."
    sf sut stop 2>/dev/null || true

    exec 9>"$REMOTE_LOCK"
    flock 9
    echo "force-reset" > "$REMOTE_LOCK"

    unmount_all
    mount_worktree "$REMOTE_MAIN/code" "$REMOTE_MAIN/artifacts"
    direnv allow "$REMOTE_MOUNT" 2>/dev/null || true
    direnv allow "$REMOTE_TRUNK" 2>/dev/null || true

    echo "" > "$REMOTE_LOCK"
    flock -u 9 2>/dev/null || true
    info "Reset complete — main is now active"
}

cmd_remote_remove() {
    local name="$1"
    [[ -n "$name" ]] || die "Usage: worktree remote-remove <name>"

    local wt="$REMOTE_ROOT/worktree-$name"
    [[ -d "$wt" ]] || die "Remote worktree not found: $wt"

    # Refuse if currently active
    if mountpoint -q "$REMOTE_MOUNT" 2>/dev/null; then
        local src
        src=$(findmnt -n -o SOURCE "$REMOTE_MOUNT" 2>/dev/null || echo "")
        if [[ "$src" == "$wt/code" ]]; then
            die "Worktree '$name' is currently active. Run 'worktree deactivate' first."
        fi
    fi

    # Remove git worktree registration
    if [[ -d "$REMOTE_MAIN/code/.git" ]]; then
        git -C "$REMOTE_MAIN/code" worktree remove --force "$wt/code" 2>/dev/null || true
    fi

    rm -rf "$wt"
    info "Removed remote worktree: $wt"
}

cmd_remote_sync() {
    info "Syncing main on remote..."
    git -C "$REMOTE_MAIN/code" fetch origin
    git -C "$REMOTE_MAIN/code" merge --ff-only origin/main
    info "Remote main is up to date"
}

# ── Local commands (Mac) ──────────────────────────────────────────────────────

cmd_create() {
    local name="" remote="" base="main"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --remote|-r) remote="$2"; shift 2 ;;
            --base|-b)   base="$2";   shift 2 ;;
            *)           name="$1";   shift   ;;
        esac
    done
    [[ -n "$name" ]]   || die "Usage: worktree create <name> --remote <host> [--base <branch>]"
    [[ -n "$remote" ]] || die "Remote host required: --remote <host>"

    local local_wt="$LOCAL_ROOT/worktree-$name"
    [[ ! -d "$local_wt" ]] || die "Local worktree already exists: $local_wt"

    # 1. Create local worktree
    info "Creating local worktree '$name' from '$base'..."
    mkdir -p "$LOCAL_ROOT"
    git -C "$LOCAL_MAIN" worktree add "$local_wt" -b "$name" "$base"

    # Symlink .mcp.json if present
    [[ -f "$LOCAL_MAIN/.mcp.json" ]] && ln -sf "$LOCAL_MAIN/.mcp.json" "$local_wt/.mcp.json"

    # 2. Create remote directories
    info "Creating remote directories on $remote..."
    remote_worktree "$remote" "remote-create $name"

    # 3. Save metadata
    meta_write "$name" "$remote" "$name"
    info "Saved metadata: $(meta_file "$name")"

    echo ""
    echo "Worktree '$name' created."
    echo "  Local:  $local_wt"
    echo "  Remote: $remote:$REMOTE_ROOT/worktree-$name"
    echo ""
    echo "Make your changes, then: worktree deploy $name"
}

cmd_deploy() {
    local name="$1"
    [[ -n "$name" ]] || die "Usage: worktree deploy <name>"

    local local_wt="$LOCAL_ROOT/worktree-$name"
    [[ -d "$local_wt" ]] || die "Local worktree not found: $local_wt"

    local remote branch
    remote=$(meta_read "$name" REMOTE)
    branch=$(meta_read "$name" BRANCH)

    # 1. Ensure branch has at least one commit (git worktree add -b creates an unpushed branch)
    local status
    status=$(git -C "$local_wt" status --porcelain)
    if [[ -n "$status" ]]; then
        die "Worktree has uncommitted changes. Commit or stash them first."
    fi

    # 2. Push branch to origin
    info "Pushing branch '$branch' to origin..."
    git -C "$local_wt" push -u origin "$branch"

    # 3. On remote: fetch + checkout branch as worktree
    info "Checking out branch on remote ($remote)..."
    remote_run "$remote" "
        set -e
        wt=$REMOTE_ROOT/worktree-$name
        cd $REMOTE_MAIN/code
        git fetch origin
        if git worktree list | grep -q \"\$wt/code\"; then
            git -C \"\$wt/code\" pull --ff-only origin $branch
        else
            git worktree add \"\$wt/code\" $branch
        fi
    "

    info "Deployed. Activate with: worktree activate $name"
}

cmd_sync() {
    is_mac || die "'sync' must be run from your local machine"

    # 1. Sync local main
    info "Syncing local main..."
    git -C "$LOCAL_MAIN" fetch origin
    git -C "$LOCAL_MAIN" merge --ff-only origin/main

    # 2. Sync remote main on all known remotes
    local remotes
    remotes=$(find "$META_DIR" -name "*.env" -exec grep -h '^REMOTE=' {} \; 2>/dev/null | sort -u | sed 's/REMOTE=//')

    if [[ -z "$remotes" ]]; then
        info "No remote hosts found in metadata. Skipping remote sync."
        return
    fi

    local synced=()
    while IFS= read -r host; do
        if [[ " ${synced[*]} " == *" $host "* ]]; then
            continue
        fi
        info "Syncing remote main on $host..."
        remote_worktree "$host" "remote-sync" && synced+=("$host") || echo "warning: sync failed on $host" >&2
    done <<< "$remotes"

    info "Sync complete"
}

cmd_activate() {
    local name="" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=true; shift ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "Usage: worktree activate [--force] <name>"

    local remote
    remote=$(meta_read "$name" REMOTE)
    local flag=""; [[ "$force" == true ]] && flag="--force"
    remote_worktree "$remote" "remote-activate $flag $name"
}

cmd_deactivate() {
    local name="${1:-}"
    if [[ -n "$name" ]]; then
        local remote
        remote=$(meta_read "$name" REMOTE)
        remote_worktree "$remote" "remote-deactivate"
    else
        # Try to find a host from any active worktree
        die "Usage: worktree deactivate <name>  (need name to determine which remote)"
    fi
}

cmd_force_reset() {
    local name="$1"
    [[ -n "$name" ]] || die "Usage: worktree force-reset <name>"
    local remote
    remote=$(meta_read "$name" REMOTE)
    remote_worktree "$remote" "remote-force-reset"
}

cmd_ls() {
    echo "Local worktrees ($LOCAL_ROOT):"
    if [[ -d "$LOCAL_ROOT" ]]; then
        for d in "$LOCAL_ROOT"/worktree-*/; do
            [[ -d "$d" ]] || continue
            local wname; wname=$(basename "$d")
            local branch remote
            branch=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
            remote=$(meta_read "${wname#worktree-}" REMOTE 2>/dev/null || echo "?")
            echo "  $wname  branch=$branch  remote=$remote"
        done
    else
        echo "  (none)"
    fi

    echo ""
    # Show remote status for each unique host
    local remotes
    remotes=$(find "$META_DIR" -name "*.env" -exec grep -h '^REMOTE=' {} \; 2>/dev/null | sort -u | sed 's/REMOTE=//')
    while IFS= read -r host; do
        [[ -z "$host" ]] && continue
        echo "Remote status on $host:"
        remote_worktree "$host" "remote-status" 2>/dev/null || echo "  (could not connect to $host)"
    done <<< "$remotes"
}

cmd_remove() {
    local name="" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=true; shift ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "Usage: worktree remove [--force] <name>"

    local local_wt="$LOCAL_ROOT/worktree-$name"
    local remote
    remote=$(meta_read "$name" REMOTE)

    # Remove remote worktree first
    info "Removing remote worktree on $remote..."
    remote_worktree "$remote" "remote-remove $name"

    # Remove local worktree
    if [[ -d "$local_wt" ]]; then
        info "Removing local worktree..."
        local flag=""; [[ "$force" == true ]] && flag="--force"
        git -C "$LOCAL_MAIN" worktree remove $flag "$local_wt"
    fi

    meta_delete "$name"
    info "Worktree '$name' removed"
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

case "${1:-}" in
    # Local commands
    create)       shift; is_mac && cmd_create "$@"       || die "'create' must be run locally" ;;
    deploy)       shift; is_mac && cmd_deploy "$@"       || die "'deploy' must be run locally" ;;
    sync)         shift; cmd_sync "$@" ;;
    activate)     shift; is_mac && cmd_activate "$@"     || cmd_remote_activate "$@" ;;
    deactivate)   shift; is_mac && cmd_deactivate "$@"   || cmd_remote_deactivate "$@" ;;
    force-reset)  shift; is_mac && cmd_force_reset "$@"  || cmd_remote_force_reset "$@" ;;
    ls|list)      shift; is_mac && cmd_ls "$@"           || cmd_remote_status "$@" ;;
    remove|rm)    shift; is_mac && cmd_remove "$@"       || cmd_remote_remove "$@" ;;

    # Remote-only commands (called via SSH or directly on remote)
    remote-activate)    shift; cmd_remote_activate "$@" ;;
    remote-deactivate)  shift; cmd_remote_deactivate "$@" ;;
    remote-force-reset) shift; cmd_remote_force_reset "$@" ;;
    remote-init)        shift; cmd_remote_init "$@" ;;
    remote-status)      shift; cmd_remote_status "$@" ;;
    remote-create)      shift; cmd_remote_create "$@" ;;
    remote-remove)      shift; cmd_remote_remove "$@" ;;
    remote-sync)        shift; cmd_remote_sync "$@" ;;

    *)
        echo "Usage: worktree <command> [args]"
        echo ""
        echo "Local commands (run from Mac):"
        echo "  create <name> --remote <host> [--base <branch>]"
        echo "  deploy <name>          Push branch and checkout on remote"
        echo "  sync                   Pull main locally and on all remotes"
        echo "  activate <name>        Bind-mount worktree on remote"
        echo "  deactivate <name>      Restore main on remote"
        echo "  force-reset <name>     Force-reset to main, ignoring lock"
        echo "  ls                     List local worktrees + remote status"
        echo "  remove <name>          Remove local + remote worktree"
        echo ""
        echo "Remote commands (run on server, also called via SSH):"
        echo "  remote-init            Restore base bind mounts after reboot"
        echo "  remote-status          Show current mount state"
        ;;
esac
